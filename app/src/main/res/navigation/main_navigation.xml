<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/loginFragment">

    <!-- LOGIN -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.trabajofinal2024.LoginFragment"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_encuestasListFragment"
            app:destination="@id/encuestasListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <!-- LISTADO DE ENCUESTAS (AHORA EN COMPOSE) -->
    <fragment
        android:id="@+id/encuestasListFragment"
        android:name="com.example.trabajofinal2024.EncuestasListComposeFragment"
        tools:layout="@layout/fragment_placeholder_compose">

        <!-- Iniciar nueva encuesta -->
        <action
            android:id="@+id/action_encuestasList_to_encuestaFragment"
            app:destination="@id/encuestaFragment" />

        <!-- Reanudar encuesta -> foodFragment -->
        <action
            android:id="@+id/action_encuestasList_to_foodFragment"
            app:destination="@id/foodFragment" />

        <!-- Navegar a Mapa -->
        <action
            android:id="@+id/action_encuestasList_to_mapFragment"
            app:destination="@id/mapaFragment" />

        <!-- Navegar a Estadísticas -->
        <action
            android:id="@+id/action_encuestasList_to_statsFragment"
            app:destination="@id/statsFragment" />

        <!-- Volver al login (cerrar sesión) -->
        <action
            android:id="@+id/action_encuestasListFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- DATOS INICIALES DE ENCUESTA -->
    <fragment
        android:id="@+id/encuestaFragment"
        android:name="com.example.trabajofinal2024.EncuestaFragment"
        tools:layout="@layout/fragment_encuesta">

        <action
            android:id="@+id/action_encuestaFragment_to_foodFragment"
            app:destination="@id/foodFragment" />
    </fragment>

    <!-- CARGA DE ALIMENTOS -->
    <fragment
        android:id="@+id/foodFragment"
        android:name="com.example.trabajofinal2024.FoodFragment"
        tools:layout="@layout/fragment_food">

        <argument
            android:name="encuestaid"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <!-- MAPA -->
    <fragment
        android:id="@+id/mapaFragment"
        android:name="com.example.trabajofinal2024.MapaFragment"
        android:label="Mapa"
        tools:layout="@layout/fragment_mapa" >
        <action
            android:id="@+id/action_mapaFragment_to_encuestasListFragment"
            app:destination="@id/encuestasListFragment" />
    </fragment>

    <!-- ESTADÍSTICAS -->
    <fragment
        android:id="@+id/statsFragment"
        android:name="com.example.trabajofinal2024.StatsFragment"
        tools:layout="@layout/fragment_stats" />
</navigation>
