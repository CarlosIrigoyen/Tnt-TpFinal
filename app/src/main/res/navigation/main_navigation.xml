<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/loginFragment">

    <!-- Acción global: desde cualquier fragmento / código usar R.id.action_global_to_foodFragment -->
    <action
        android:id="@+id/action_global_to_foodFragment"
        app:destination="@id/foodFragment" />

    <!-- Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.trabajofinal2024.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_welcomeLogin"
            app:destination="@id/welcomeLogin" />
    </fragment>

    <!-- Welcome -->
    <fragment
        android:id="@+id/welcomeLogin"
        android:name="com.example.trabajofinal2024.WelcomeLogin"
        android:label="fragment_welcome_login"
        tools:layout="@layout/fragment_welcome_login" >
        <action
            android:id="@+id/action_welcomeLogin_to_encuestaFragment"
            app:destination="@id/encuestaFragment" />
    </fragment>

    <!-- Encuesta (puede iniciar FoodFragment pasando encuestaid) -->
    <fragment
        android:id="@+id/encuestaFragment"
        android:name="com.example.trabajofinal2024.EncuestaFragment"
        android:label="fragment_encuesta"
        tools:layout="@layout/fragment_encuesta" >
        <action
            android:id="@+id/action_encuestaFragment_to_welcomeLogin"
            app:destination="@id/welcomeLogin" />

        <!-- acción local (opcional) -->
        <action
            android:id="@+id/action_encuestaFragment_to_foodFragment"
            app:destination="@id/foodFragment" />
    </fragment>

    <!-- Otros fragments "no alimentarios" que quieras conservar:
         (los dejé solo a modo de marcador; quítalos si no los usas)
    -->

    <!-- Ejemplo de fragmento auxiliar (si los necesitás, mantenelos; si no, borralos) -->
    <fragment
        android:id="@+id/otrosFragment"
        android:name="com.example.trabajofinal2024.OtrosFragment"
        android:label="OtrosFragment"
        tools:layout="@layout/fragment_otros" >
        <action
            android:id="@+id/action_otrosFragment_to_encuestaFragment"
            app:destination="@id/encuestaFragment" />
    </fragment>

    <!--  Fragmento único de alimentos  -->
    <fragment
        android:id="@+id/foodFragment"
        android:name="com.example.trabajofinal2024.FoodFragment"
        android:label="FoodFragment"
        tools:layout="@layout/fragment_food" >
        <argument
            android:name="encuestaid"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

</navigation>
