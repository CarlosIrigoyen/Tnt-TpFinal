<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMapa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MapaFragment">

    <!-- ================= MAPA ================= -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ================= BOTÓN VOLVER ================= -->
    <ImageButton
        android:id="@+id/btnVolver"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_circle"
        android:padding="12dp"
        android:src="@android:drawable/ic_media_previous"
        android:contentDescription="@string/volver"
        app:tint="@android:color/white"
        android:elevation="6dp" />

    <!-- ================= LEYENDA ================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLeyenda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="top|end"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#CCFFFFFF">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Título -->
            <TextView
                android:id="@+id/tvLeyendaTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado de Encuestas"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@android:color/black"
                android:paddingBottom="8dp" />

            <!-- COMPLETADAS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:background="#4CAF50" />

                <TextView
                    android:id="@+id/tvCompletadasLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completadas:"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"/>

                <!-- valor dinámico -->
                <TextView
                    android:id="@+id/tvCompletadasValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:textColor="@android:color/black"/>
            </LinearLayout>

            <!-- PAUSADAS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:background="#FF5722" />

                <TextView
                    android:id="@+id/tvPausadasLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pausadas:"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"/>

                <!-- valor dinámico -->
                <TextView
                    android:id="@+id/tvPausadasValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:textColor="@android:color/black"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
