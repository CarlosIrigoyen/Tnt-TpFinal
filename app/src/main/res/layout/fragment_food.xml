<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="foodItem"
            type="com.example.trabajofinal2024.FoodItem" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frameLayout4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:context=".FoodFragment"
            android:padding="16dp">

            <!-- Indicador de progreso -->
            <TextView
                android:id="@+id/progresoText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Alimento 1 de 35"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"
                android:background="@android:color/holo_blue_dark"
                android:textColor="@android:color/white"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Nombre del alimento (ocupando todo el ancho encima de las dos columnas) -->
            <TextView
                android:id="@+id/alimentoNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{foodItem.alimentoNombre}"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:ellipsize="none"
                android:maxLines="2"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/progresoText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- GUIDELINE vertical para dividir columnas -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.42"
                android:orientation="vertical" />

            <!-- COLUMNA IZQUIERDA: Frecuencia -->
            <TextView
                android:id="@+id/frecuenciaTextId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Frecuencia"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/alimentoNombre"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/guideline"/>

            <RadioGroup
                android:id="@+id/frecuenciaGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/frecuenciaTextId"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/guideline"
                app:layout_constraintHorizontal_bias="0">

                <RadioButton
                    android:id="@+id/radioDiaria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diaria"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp"/>

                <RadioButton
                    android:id="@+id/radioSemanal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semanal"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp"/>

                <RadioButton
                    android:id="@+id/radioMensual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mensual"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp"/>

                <RadioButton
                    android:id="@+id/radioAnual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anual"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp"/>

                <RadioButton
                    android:id="@+id/radioNunca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nunca"
                    android:textSize="16sp"/>
            </RadioGroup>

            <!-- COLUMNA DERECHA: Cantidad -->
            <TextView
                android:id="@+id/cantidadText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Cantidad"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/alimentoNombre"
                app:layout_constraintStart_toEndOf="@id/guideline"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/cantidadUnidadText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="(en gramos o ml)"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/cantidadText"
                app:layout_constraintStart_toStartOf="@id/cantidadText"
                app:layout_constraintEnd_toEndOf="parent"/>

            <LinearLayout
                android:id="@+id/cantidadLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/cantidadUnidadText"
                app:layout_constraintStart_toStartOf="@id/cantidadText"
                app:layout_constraintEnd_toEndOf="parent">

                <Button
                    android:id="@+id/decrement"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:textSize="20sp"
                    android:layout_marginEnd="8dp"/>

                <Spinner
                    android:id="@+id/spinnerOpciones"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/increment"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="20sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Sección de número de veces -->
            <TextView
                android:id="@+id/vecesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Número de veces:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@id/frecuenciaGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/vecesInput"/>

            <EditText
                android:id="@+id/vecesInput"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:inputType="number"
                android:text="@={foodItem.numeroveces}"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="@id/vecesText"
                app:layout_constraintBottom_toBottomOf="@id/vecesText"
                app:layout_constraintStart_toEndOf="@id/vecesText"/>

            <!-- Botones inferiores -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="48dp"
                app:layout_constraintTop_toBottomOf="@id/vecesText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:paddingBottom="24dp">

                <Button
                    android:id="@+id/cancelarEncuesta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Volver"
                    android:textSize="16sp"
                    android:padding="12dp"/>

                <Button
                    android:id="@+id/abandonarEncuesta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="Abandonar"
                    android:textSize="16sp"
                    android:padding="12dp"/>

                <Button
                    android:id="@+id/siguienteAlimento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Siguiente"
                    android:textSize="16sp"
                    android:padding="12dp"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>
